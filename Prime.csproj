<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Prime</AssemblyTitle>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>Prime</Product>
    <AssemblyName>Prime</AssemblyName>
    <Version>1.0.0</Version>
    <Description>A native Windows calculator styled after GNOME Calculator.</Description>
    <!-- Ship only English satellite resources; keeps the publish folder free of ~dozens of empty locale folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- icon.ico -> exe/taskbar icon (via ApplicationIcon above);
       icon.png -> runtime window icon, loaded in MainWindow.xaml.cs (Window_Loaded). -->
  <ItemGroup>
    <Resource Include="icon.ico"/>
    <Resource Include="icon.png"/>
  </ItemGroup>

  <!-- No PublishSingleFile/SelfContained here by design: those are passed as
       flags on the publish command (see README) rather than baked into the
       project, since they only apply to the release/publish step. -->

</Project>
